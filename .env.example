# Any OpenAI-compatible API. The engine calls {LLM_BASE_URL}/models and
# {LLM_BASE_URL}/chat/completions.
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini

# Secret required by mutating engine calls (POST /chat, /predict, ...).
# Any POST to /api/engine/* must send it as the x-engine-key header.
ENGINE_PROXY_KEY=generate-a-long-random-string

# Optional engine tuning (all read from env, see upstream .env.example):
# HORIZONS=24h,week,month,year
# PREDICTIONS_PER_HORIZON=3
# LOOP_INTERVAL_SEC=900
# ORACLE_TEMPERATURE=0.5
# ORACLE_TIMEOUT_SEC=180
# SWARM_ENABLED=true
# SWARM_MAX_TOKENS=2400
# SWARM_CONCURRENCY=1
# JUDGE_MAX_TOKENS=700
